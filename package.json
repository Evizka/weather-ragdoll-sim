{
  "name": "weather-ragdoll-sim",
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "author": "Weather Ragdoll Sim",
  "description": "Симулятор катастроф и погоды от первого лица с реалистичной физикой",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "electron": "electron electron/main.js",
    "electron:dev": "concurrently \"vite --host 0.0.0.0 --port 5173\" \"wait-on http://localhost:5173 && electron electron/main.js\"",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win --x64",
    "dist:linux": "vite build && electron-builder --linux",
    "dist:all": "vite build && electron-builder --win --linux"
  },
  "dependencies": {
    "three": "^0.160.0",
    "cannon-es": "^0.20.0"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.9.1",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.weather.ragdollsim",
    "productName": "Weather Ragdoll Sim",
    "copyright": "Weather Ragdoll Sim",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Weather Ragdoll Sim"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "electron/icon.png",
      "category": "Game"
    },
    "portable": {
      "artifactName": "Weather-Ragdoll-Sim-${version}-portable.exe"
    }
  }
}
